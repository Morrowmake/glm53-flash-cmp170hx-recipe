# Environment for running the engine image by hand with `docker run`, with
# this repository's serve.sh mounted as the entry point (see README.md in this
# folder). serve.sh turns these into the same settings and flags as a native
# start, so every other setting in ../.env.example can be added here too.
# ./start.sh does not read this file: it writes the same thing from .env.
# Format: KEY=value, one per line, no quotes, no notes after a value.
#
# Layout: tp4 (tensor-parallel 4, the default) or pp4 (pipeline-parallel 4).
LAYOUT=tp4
#
# PCIe peer-to-peer is off. To turn it on under tp4 (only if
# `nvidia-smi topo -p2p r` answers OK for every pair), set it to 1; serve.sh
# picks the matching allocator. It does nothing under pp4.
VLLM_ALLOW_PCIE_P2P_CUSTOM_ALLREDUCE=0
#
# Paths inside the container. Leave these as they are; the host directories
# are mounted onto them by the docker run command.
VENV=/opt/venv
MODEL=/models/GLM-5.3-Flash-W4A16-MTP
DFLASH_MODEL=/models/GLM-5.3-Flash-DFlash2
CUDA_HOME=/usr/local/cuda
HOST=0.0.0.0
PORT=8000
#
# Caches. The run command starts the server as you (--user), not root, so
# everything it writes lands in the mounted cache directory, owned by you.
HOME=/cache
USER=recipe
LOGNAME=recipe
XDG_CACHE_HOME=/cache/.cache
HF_HOME=/cache/huggingface
FLASHINFER_WORKSPACE_BASE=/cache
TORCHINDUCTOR_CACHE_DIR=/cache/torchinductor

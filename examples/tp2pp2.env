# Hybrid: two pipeline stages, each a TP=2 pair (PP=2, TP=2). Copy to ../.env
# (or add the LAYOUT line to your .env) and run ./start.sh restart.
# Composes the PP>1 and TP>1 optimisation branches so prefill overlap, local
# logits, host-staged all-reduce, packed hop, spread decodes, drafter tail
# stage, PP block size and both prefill-kernel families all engage; the
# engine's own shape gates decide which actually fire on 2-rank shards.
# Layer partition and prefill chunk defaults are scaffolded, not independently
# measured on tp2pp2 -- retune for your rig before trusting any numbers.
LAYOUT=tp2pp2
# HOST=127.0.0.1
# PORT=8000
# API_KEY=
# SERVED_MODEL_NAME=glm-5.3-flash
# P2P=auto
# Overrides worth measuring on your cards:
# VLLM_PP_LAYER_PARTITION=23,22      # dflash default; try 24,21 or 22,23
# MAX_BATCHED=2312                   # 2,304-token chunks (default); 3460 for 3,456
# VLLM_PP_DRAFT_TAIL_STAGE=1         # last stage (default for PP=2)

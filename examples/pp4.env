# Pipeline-parallel 4. Copy to ../.env (or add the line to your .env) and run
# ./start.sh restart. Faster prefill and about twice the KV pool, for many
# parallel users, long prompts and cards limited to x4 links.
# The prefill chunk (MAX_BATCHED) and KV block size already follow the layout;
# every other setting follows the release defaults in ../.env.example.
LAYOUT=pp4

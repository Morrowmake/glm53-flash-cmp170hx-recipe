# Tensor-parallel 4, the default. Copy to ../.env and run ./start.sh.
# The fastest answer per request for one or two interactive users; assumes
# PCIe x16 links between the cards. Uses only settings from ../.env.example;
# everything not set here follows the release defaults.
LAYOUT=tp4
# HOST=127.0.0.1
# PORT=8000
# API_KEY=
# SERVED_MODEL_NAME=glm-5.3-flash
# P2P=auto

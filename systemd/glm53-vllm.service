# Run the server from this repo as a system service.
#
# Install (adjust the two paths and the user, then):
#   sudo cp systemd/glm53-vllm.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now glm53-vllm.service
#   journalctl -u glm53-vllm -f        # or tail logs/serve.log
#
# Replace /opt/glm53-recipe with wherever you cloned this repo, and REPLACE_USER
# with the account that owns it and the models. Everything else tunable lives in
# serve.sh; override individual knobs here with extra Environment= lines
# (Environment=MAX_LEN=131072, Environment=VLLM_GLM5_DECODE_KERNELS=0, ...).

[Unit]
Description=vLLM GLM-5.3-Flash W4A16 (tensor-parallel 4, DFlash2) on 4x CMP 170HX
After=network-online.target cmp-power-limit.service
Wants=network-online.target

[Service]
Type=simple
User=REPLACE_USER
Group=REPLACE_USER
WorkingDirectory=/opt/glm53-recipe
ExecStart=/opt/glm53-recipe/serve.sh dflash
# vLLM spawns worker processes; stop the whole group and give it time to release the GPUs.
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=90
Restart=on-failure
RestartSec=20
# Model load + CUDA graph capture takes several minutes; don't let systemd give up early.
TimeoutStartSec=900
LimitNOFILE=1048576
StandardOutput=append:/opt/glm53-recipe/logs/serve.log
StandardError=append:/opt/glm53-recipe/logs/serve.log

[Install]
WantedBy=multi-user.target

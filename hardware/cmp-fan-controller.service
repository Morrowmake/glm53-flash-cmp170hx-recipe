# Temperature-driven chassis + GPU fan control.
#
# These cards ship without their own fans: they are passive server parts that
# expect chassis airflow, and at 180 W each they need a lot of it. This unit
# drives whatever controller script you write for your own chassis; the script
# itself is machine-specific and is NOT part of this recipe.
#
# The unit is included only as a reminder that you need something like it.
# Write /usr/local/sbin/cmp-fan-controller.py to read nvidia-smi temperatures
# and set your fan PWMs, then:
#   sudo cp hardware/cmp-fan-controller.service /etc/systemd/system/
#   sudo systemctl enable --now cmp-fan-controller.service

[Unit]
Description=Temperature-based chassis and CMP GPU fan controller
After=multi-user.target nvidia-persistenced.service
ConditionPathExists=/usr/bin/nvidia-smi

[Service]
Type=simple
ExecStart=/usr/local/sbin/cmp-fan-controller.py
Restart=always
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target

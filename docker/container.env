# Environment for the container: serve.sh's defaults in release 1.3.0 for
# tensor-parallel 4 with the DFlash2 drafter, written out, because the
# container runs the vllm CLI directly and not serve.sh.
# Used with: docker run --env-file docker/container.env ...
# Format: KEY=value, one per line, no quotes, no notes after a value.
#
# PCIe peer-to-peer is off. To turn it on (only if `nvidia-smi topo -p2p r`
# answers OK for every pair), set both:
#   VLLM_ALLOW_PCIE_P2P_CUSTOM_ALLREDUCE=1
#   PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False
CUDA_HOME=/usr/local/cuda
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
VLLM_ALLOW_PCIE_P2P_CUSTOM_ALLREDUCE=0
VLLM_CUSTOM_ALLREDUCE_ALGO=2stage
VLLM_GLM5_DECODE_IDX_GLUE=1
VLLM_GLM5_DECODE_KDA_V2=1
VLLM_GLM5_DECODE_KERNELS=1
VLLM_GLM5_DECODE_MHC_V2=1
VLLM_GLM5_DECODE_MOE_ROUTE_V2=1
VLLM_GLM5_DETERMINISTIC_MOE_ALIGN=1
VLLM_GLM5_DRAFTER_ROPE_FIT=1
VLLM_GLM5_DRAFTER_SELECTOR_SHARD=1
VLLM_GLM5_HOST_ALLREDUCE=1
VLLM_GLM5_INDEXER_DECODE_ROWS=1
VLLM_GLM5_LOCAL_LOGITS=1
VLLM_GLM5_MOE_MASK_PADDING=1
VLLM_GLM5_PREFILL_KERNELS=1
VLLM_GLM5_PREFILL_MIN_TOKENS=384
VLLM_GLM5_PREFILL_OVERLAP=1
VLLM_GLM5_PREFILL_OVERLAP_SPLITS=2
VLLM_GLM5_PROLOGUE_FUSE=1
VLLM_GLM5_REPLICATED_EMBED=0
VLLM_GLM5_SHARED_EXPERT_REORDER=1
VLLM_GLM5_THIN_GEMM=1
VLLM_GLM5_TOPK_SORTED=1
VLLM_GLM5_TOPK_TIEFIX=1
VLLM_GLM5_TOPK_TIEFIX_SPLIT_ROWS=8
VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=128
